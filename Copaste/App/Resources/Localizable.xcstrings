    "cleanupFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes the entries that match all of these, from the vault on every device that syncs it. Pinned entries are kept unless you include them. This can't be undone."
