    "importFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brings in the images and rich-text copies Raycast keeps. Raycast encrypts the rest of its history (plain text, copy counts, source apps), so those can't be moved. Entries already here are skipped."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengimpor gambar dan salinan teks berformat yang disimpan Raycast. Sisa riwayat Raycast (teks biasa, jumlah salin, aplikasi sumber) dienkripsi sehingga tidak bisa dipindahkan. Entri yang sudah ada dilewati."
          }
        }
      }
