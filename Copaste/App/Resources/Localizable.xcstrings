        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus entri yang cocok dengan semua pilihan ini, dari vault di setiap perangkat yang menyinkronkannya. Entri yang disematkan tetap disimpan kecuali Anda ikutkan. Ini tidak bisa dibatalkan."
          }
        }
      }
